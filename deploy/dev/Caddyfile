{
  admin off
  auto_https disable_redirects
  default_sni {$DEV_HOST}
  servers {
    protocols h1 h2
  }
}
https://{$DEV_HOST}:8443 {
  tls internal
  encode zstd gzip
  reverse_proxy app:3001
}
http://:8081 {
  handle /healthz {
    rewrite * /api/health
    reverse_proxy app:3001
  }
  respond 404
}
