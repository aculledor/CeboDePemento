NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Relative paths are always resolved from the repository root.
DATABASE_PATH=data/catalogo.sqlite
# Browser origins allowed to perform writes (no wildcard).
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PHOTO_DIRECTORY=data/photos
BACKUP_INTERVAL_HOURS=0
# For Linux Compose, use your real DNS name (without scheme).
# DOMAIN=
