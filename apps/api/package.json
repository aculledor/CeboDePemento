{
  "name": "@cebo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node --import tsx src/cli.ts migrate",
    "backup": "node --import tsx src/cli.ts backup",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "admin": "node --import tsx src/cli.ts admin",
    "invite": "node --import tsx src/cli.ts invite",
    "recovery": "node --import tsx src/cli.ts recovery"
  },
  "dependencies": {
    "@cebo/shared": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.2",
    "luxon": "^3.7.2",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.6",
    "tsx": "^4.20.6"
  }
}
